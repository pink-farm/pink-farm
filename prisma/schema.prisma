generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

model Product {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String           @unique
  shortDescription String
  description      String
  imageUrl         String
  additionalImages String           @default("[]")
  basePrice        Int              // In paise (1 INR = 100 paise)
  originalPrice    Int?             // In paise
  sku              String           @unique
  category         String
  stockQuantity    Int              @default(0)
  lowStockThreshold Int             @default(5)
  isAvailable      Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  tags             String           @default("[]")
  highlights       String?
  ingredients      String?
  nutritionalInfo  String?
  storage          String?
  allergens        String?
  deliveryNotes    String?
  seoTitle         String?
  seoDesc          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          ProductReview[]
  comments         ProductComment[]
}

model ProductVariant {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  productId        String      @db.ObjectId
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String      // e.g., "250g", "500g"
  packSize         String
  price            Int         // In paise
  originalPrice    Int?        // In paise
  stockQuantity    Int         @default(0)
  isAvailable      Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Order {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber      String      @unique // e.g., PF-2026-00001
  customerName     String
  customerPhone    String
  customerId       String?     @db.ObjectId
  customer         Customer? @relation(fields: [customerId], references: [id])
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  pinCode          String
  deliveryInstructions String?
  subtotal         Int         // In paise
  deliveryFee      Int         // In paise
  discount         Int         @default(0)
  couponCode       String?
  totalAmount      Int         // In paise

  paymentStatus    String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod    String      @default("COD")
  fulfillmentStatus String     @default("PENDING") // PENDING, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED

  trackingNumber   String?     // AWB / Consignment tracking number
  carrierName      String?     // Courier partner details (e.g. Delhivery, Blue Dart, etc.)
  trackingUrl      String?     // Custom tracking URL (or auto-resolved)

  gatewayOrderId   String?
  gatewayPaymentId String?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            OrderItem[]
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  passwordHash String?
  phone     String?
  dob       String?
  gender    String?
  dietaryPreferences String @default("[]")
  preferences String @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  addresses CustomerAddress[]
  orders    Order[]
  productReviews ProductReview[]
  productComments ProductComment[]
}

model ProductReview {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, customerId])
  @@index([productId, createdAt])
}

model ProductComment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, createdAt])
  @@index([customerId, createdAt])
}

model CustomerAddress {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pinCode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OtpChallenge {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  purpose   String?
  customerName String?
  passwordHash String?
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  @@index([email, createdAt])
}

model OrderItem {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  orderId          String      @db.ObjectId
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String      @db.ObjectId
  variantId        String?     @db.ObjectId
  product          Product     @relation(fields: [productId], references: [id])
  variantName      String?
  quantity         Int
  unitPrice        Int         // In paise
  subtotal         Int         // In paise
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model StoreSettings {
  id                  String   @id @default("default") @map("_id")
  storeName           String   @default("Pink Farm")
  announcementText    String   @default("Welcome to Pink Farm — Goodness in Every Bite.")
  heroMainImage       String?
  heroGheeImage       String?
  heroAlmondsImage    String?
  heartProductId      String?
  heartProductTitle   String   @default("Premium Phool Makhana")
  heartProductTagline String   @default("Why not? You deserve the best.")
  heartProductFeatures String[] @default(["Plant-Based", "Gluten-Free", "Low Calorie", "High Calcium", "No Frying", "No Preservatives", "Farm to Table", "Hygienically Packed"])
  heartProductButtonText String @default("Shop Now")
  heartProductButtonUrl  String?
  heartProductSubtitle   String @default("Our Heart Product")
  heartProductImage      String?
  featuredProductId   String?
  featuredProductHeading String @default("Meet Your New Favourite Snack.")
  featuredProductDescription String @default("Handpicked, light & wholesome")
  featuredProductImage String?
  featuredProductButtonText String @default("View Details & Add to Cart")
  founderName String @default("Anjali")
  founderImage String?
  founderRole String @default("Founder & Dietitian")
  founderStoryFirst String @default("Anjali started her journey as a trained dietitian — someone who spent years understanding the deep connection between what we eat and how we feel. She knew that truly good food doesn't need artificial anything. It just needs care, intention, and the right source.")
  founderStorySecond String @default("That belief became the seed of Pink Farm. What began as a personal mission to bring honest, nutritious snacks to her own family soon turned into something much bigger — a food brand built on trust, quality, and a quiet promise to never cut corners.")
  founderQuote String @default("Pure in nature, good for you. Simple food, stronger you.")
  founderTags String[] @default(["Nutrition", "Food Science", "Innovation", "Entrepreneur", "Founder", "Curator"])
  supportPhone        String   @default("+91 8437504040")
  supportEmail        String   @default("wecare@pinkfarm.in")
  businessAddress     String   @default("Dugri, Ludhiana, Punjab - 141003")
  deliveryFee         Int      @default(5000) // 50 INR in paise
  freeDeliveryThreshold Int?   @default(50000) // 500 INR
  isAcceptingOrders   Boolean  @default(true)
  // Combo Builder Settings
  comboEnabled        Boolean  @default(true)
  comboEyebrow        String   @default("Make Your Own Combo")
  comboTitlePrefix    String   @default("Curate Your")
  comboTitleHighlight String   @default("Pink Farm Combo")
  comboSubtitle       String   @default("Mix & match your favourite flavoured makhanas. Add multiple packs of any flavour — combo discounts apply directly on the original MRP!")
  comboTier1Count     Int      @default(3)
  comboTier1Discount  Int      @default(11) // percentage
  comboTier1Label     String   @default("Trio Combo")
  comboTier1Tagline   String   @default("Pick any 3 — save 11% on MRP")
  comboTier1Badge     String   @default("✦ 11% OFF")
  comboTier1Emoji     String   @default("🌿")
  comboTier2Count     Int      @default(5)
  comboTier2Discount  Int      @default(15) // percentage
  comboTier2Label     String   @default("Penta Combo")
  comboTier2Tagline   String   @default("Pick any 5 — save 15% on MRP")
  comboTier2Badge     String   @default("✦ 15% OFF")
  comboTier2Emoji     String   @default("🌸")
  comboButtonText     String   @default("Shop My Combo")
  comboFooterNote     String   @default("✦ Combo discount applies to total MRP ✦ Multiples allowed ✦")
  comboProductIds     String[] @default([])
  storeCategories     String[] @default(["Makhana", "Nuts", "Pantry"])
  updatedAt           DateTime @updatedAt
}

model Coupon {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  code              String   @unique
  discountType      String   // FIXED or PERCENTAGE
  discountValue     Int      // Fixed discounts in paise; percentage as whole percent
  minimumSubtotal   Int      @default(0) // paise
  maximumDiscount   Int?     // paise; used for percentage discounts
  startsAt          DateTime @default(now())
  expiresAt         DateTime?
  isActive          Boolean  @default(true)
  usageLimit        Int?
  usedCount         Int      @default(0)
  perCustomerLimit  Int?
  firstOrderOnly    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // Hashed
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthRateLimit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
