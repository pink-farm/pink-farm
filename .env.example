DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority"
SESSION_SECRET="replace_with_at_least_32_random_characters"
# Brevo transactional email for OTP delivery. Verify the sender in Brevo first.
BREVO_API_KEY="your_brevo_api_key"
BREVO_FROM_EMAIL="login@your-verified-domain.in"
BREVO_FROM_NAME="Pink Farm"
ADMIN_EMAIL="pinkfarmofficial@gmail.com"
ADMIN_PASSWORD="replace_with_a_long_unique_password"
# Add Razorpay test keys for local testing and live keys for production payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
LOCATIONIQ_API_KEY="your_locationiq_public_token"
